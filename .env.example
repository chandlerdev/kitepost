# Copy to .env and fill in. Never commit .env.

# ---- Database (JDBC URL). PostgreSQL or MySQL, chosen by the URL. ----
# DATABASE_URL=jdbc:postgresql://localhost:5432/kitepost
# DATABASE_URL=jdbc:mysql://localhost:3306/kitepost
DATABASE_URL=jdbc:mysql://localhost:3306/kitepost
DATABASE_USER=kitepost
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=10

# ---- Ports ----
# The API's port (default 8080).
PORT=8080

# ---- First admin (created only when the users table is empty) ----
# Leave blank to get admin@kitepost.local with a random password printed once in the backend log.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Sessions and cookies ----
# true in production (HTTPS). Set false only for plain http://localhost.
COOKIE_SECURE=false
SESSION_TIMEOUT=8h
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_ATTEMPTS_PER_MINUTE=10
# Only if the web app is served from a different origin than the API (normally leave blank).
ALLOWED_ORIGINS=

# ---- Web app ----
# Where the Next.js dev server forwards /api (set when it starts).
BACKEND_URL=http://localhost:8080

# ---- Finding companies (blank = demo data) ----
# serpapi | serpapi+maps (web search plus Google Maps listings) | brave | google
SEARCH_PROVIDER=
BRAVE_API_KEY=
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
RESULTS_PER_QUERY=10

# ---- Classifying (blank = keyword rules) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Reading websites ----
FETCH_TIMEOUT_MS=12000
PIPELINE_CONCURRENCY=3
RESPECT_ROBOTS=true

# ---- Sending (DRY_RUN=true records emails without sending) ----
DRY_RUN=true
SEND_INTERVAL_SECONDS=30
DAILY_SEND_LIMIT=100
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASS=

# ---- Reply tracking (the mailbox that receives the replies) ----
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=120
# In dry run, invent sample replies so the inbox can be demoed
SIMULATE_REPLIES=true

# ---- Demo ----
SEED_SAMPLE_DATA=false
RUN_WORKERS=true

# Public address of the deployed app, including any path (https://example.com/kitepost).
# Needed to record email opens; leave blank until production.
PUBLIC_URL=
