# Copy this file to .env.local (or run: npm run setup) and fill in what you have.
# Only DATABASE_URL is required. With nothing else set, Kitepost runs in demo mode
# (fictional companies, nothing sent).

# ---- Database: PostgreSQL or MySQL (MariaDB works too) ----
# PostgreSQL: postgres://user:password@host:5432/kitepost
# MySQL:      mysql://user:password@host:3306/kitepost
DATABASE_URL=postgres://kitepost:kitepost@localhost:5432/kitepost
# Create/update tables automatically when the server starts (or run: npm run db:migrate)
DB_AUTO_MIGRATE=true
# Run background jobs (search, sending, inbox) in this process. Set false on extra instances.
RUN_WORKERS=true

# PORT is set with: npm run dev -- -p 3000

# ---- Finding companies (pick one) ----
# Brave Search API: https://brave.com/search/api/
BRAVE_API_KEY=
# SerpAPI (Google results): https://serpapi.com/
SERPAPI_KEY=
# Google Programmable Search: https://programmablesearchengine.google.com/
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Force a provider: demo | brave | serpapi | google
SEARCH_PROVIDER=
RESULTS_PER_QUERY=10

# ---- Classifying leads and writing emails with Claude ----
# Without a key, keyword rules and email templates are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Sending email (SMTP) ----
# DRY_RUN=true records approved emails without sending them. Set to false to send.
DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SEND_INTERVAL_SECONDS=30
DAILY_SEND_LIMIT=100

# ---- Tracking replies (IMAP) ----
# Uses SMTP_USER / SMTP_PASS unless IMAP_USER / IMAP_PASS are set.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=120
# In dry-run mode, fake replies arrive for some recorded emails so you can try the inbox.
SIMULATE_REPLIES=true

# ---- Website reading ----
RESPECT_ROBOTS=true
FETCH_TIMEOUT_MS=12000
PIPELINE_CONCURRENCY=3
